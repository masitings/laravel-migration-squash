{
    "name": "masitings/laravel-migration-squash",
    "description": "Combine multiple Laravel migration files into consolidated migrations per table with schema verification",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "migration",
        "squash",
        "schema",
        "database"
    ],
    "authors": [
        {
            "name": "Masitings",
            "email": "youremail@example.com",
            "homepage": "https://masiting.dev"
        }
    ],
    "homepage": "https://github.com/masitings/laravel-migration-squash",
    "support": {
        "issues": "https://github.com/masitings/laravel-migration-squash/issues",
        "source": "https://github.com/masitings/laravel-migration-squash"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "MigrationSquash\\": "src/MigrationSquash/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MigrationSquash\\MigrationSquashServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
