{
    "name": "masitings/laravel-migration-squash",
    "description": "Combine multiple Laravel migration files into consolidated migrations per table with schema verification",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "migration",
        "squash",
        "schema",
        "database"
    ],
    "authors": [
        {
            "name": "Rafi Bagaskara Halilintar",
            "email": "hallo@masiting.dev",
            "homepage": "https://masiting.dev"
        }
    ],
    "homepage": "https://github.com/masitings/laravel-migration-squash",
    "support": {
        "issues": "https://github.com/masitings/laravel-migration-squash/issues",
        "source": "https://github.com/masitings/laravel-migration-squash"
    },
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "nikic/php-parser": "^5.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0",
        "phpunit/phpunit": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "MigrationSquash\\": "src/MigrationSquash/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MigrationSquash\\MigrationSquashServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "test": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage --min=70",
        "lint": "vendor/bin/pint --test",
        "lint:fix": "vendor/bin/pint"
    },
    "scripts-descriptions": {
        "test": "Run the test suite. MySQL tests skip themselves unless DB_* env vars point at a reachable server.",
        "test:coverage": "Run the test suite and fail below 70% coverage. Needs pcov or xdebug.",
        "lint": "Check code style with Pint.",
        "lint:fix": "Fix code style with Pint."
    }
}
